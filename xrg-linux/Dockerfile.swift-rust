FROM swift:6.4.1-noble
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential curl pkg-config libxkbcommon-dev libxkbcommon-x11-0 libwayland-dev libx11-dev libxi-dev libxrandr-dev libxcursor-dev libegl1-mesa-dev libgl1-mesa-dev libgl1-mesa-dri xvfb xauth xclip dbus-x11 python3 patchelf desktop-file-utils weston fluxbox picom xdotool x11-utils imagemagick \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain 1.99.1 \
       --component clippy --component rustfmt \
    && rm /tmp/rustup-init.sh
ENV PATH="/root/.cargo/bin:${PATH}" CARGO_BUILD_JOBS=2 CARGO_TARGET_DIR=/tmp/xrg-cargo-target
WORKDIR /workspace
CMD ["bash", "Tools/ci-linux.sh"]
