# ignored project.xcworkspace becomes visible.
!XRG-ng.xcodeproj/project.xcworkspace/
XRG-ng.xcodeproj/project.xcworkspace/*
!XRG-ng.xcodeproj/project.xcworkspace/xcshareddata/
XRG-ng.xcodeproj/project.xcworkspace/xcshareddata/*
!XRG-ng.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
XRG-ng.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!XRG-ng.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
xcuserdata
profile
*.moved-aside
.DS_Store

